# No Plan Studio — variables de entorno
# Copia este archivo a ".env" y cambia el token por uno propio y secreto.

# Token de acceso al panel de administración (/admin).
# Cualquier cadena larga y aleatoria sirve, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=cambia-este-token-por-uno-seguro

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
