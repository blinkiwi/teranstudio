{
  "name": "teranstudio-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Terán Studio — clon full stack con panel de administración (Node nativo + node:sqlite, sin dependencias).",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
